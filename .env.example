# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway, Neon, Supabase, or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ─────────────────────────────────────────────────────────────────
# Random secret used to sign admin/student/company session cookies
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_64_byte_hex_string

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_EMAIL=admin@mtuaefans.com

# ── Application URL ──────────────────────────────────────────────────────────
APP_URL=https://api.mtuaefans.com

# ── Google OAuth (student login) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id

# ── Google OAuth — Customer Portal (Sign in with Google) ─────────────────────
# Web client ID from Google Cloud Console (required for expo-auth-session + backend validation)
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Android client ID — package com.mtuaes.dubaifans (optional; adds to backend allowlist)
# GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Comma-separated list of additional dev hosts allowed for Google OAuth redirect
# GOOGLE_REGISTERED_DEV_HOSTS=localhost:3000

# ── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Google Cloud Storage (for report image uploads) ──────────────────────────
# Leave blank if not using file upload features
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCS_BUCKET_NAME=your-bucket-name

# ── OpenAI (for AI Business OS + tools) ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Ziina Payment Gateway ────────────────────────────────────────────────────
ZIINA_API_KEY=                # Ziina API secret key (from Ziina dashboard)
ZIINA_WEBHOOK_SECRET=test_webhook_secret   # Webhook signing secret (use a real secret in prod)
ZIINA_ENVIRONMENT=staging     # "production" to use live mode; anything else = test mode

# ── CORS ─────────────────────────────────────────────────────────────────────
# Extra allowed origin (e.g. your Cloudflare Pages preview URL in dev)
# EXTRA_CORS_ORIGIN=https://my-branch.dubai-fans-website.pages.dev
