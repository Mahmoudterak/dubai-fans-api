{
  "name": "dubai-fans-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/vendor/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "check-drift": "tsx src/vendor/db/check-schema-drift.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.27.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
